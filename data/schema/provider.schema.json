{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Model Price Provider",
  "type": "object",
  "required": ["id", "name", "currency", "updated_at", "models"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "website": {"type": ["string", "null"]},
    "currency": {"enum": ["CNY", "USD"]},
    "updated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "source_url": {"type": ["string", "null"]},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["model", "input", "output"],
        "properties": {
          "model": {"type": "string"},
          "input": {"type": "number", "minimum": 0},
          "output": {"type": "number", "minimum": 0},
          "cached_input": {"type": ["number", "null"], "minimum": 0},
          "note": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
